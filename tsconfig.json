{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ES2022"
		],
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"@types/node",
			"@cloudflare/vitest-plugin/types"
		]
	},
	"include": [
		"./**/*.ts",
		"./worker-configuration.d.ts"
	],
	"exclude": [
		"node_modules"
	]
}